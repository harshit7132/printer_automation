{
  "name": "emitra-print-studio",
  "version": "1.0.0",
  "description": "Self-service print & design ordering for an e-Mitra shop: QR → details → upload → UPI pay → owner verifies → auto print.",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "set-password": "node scripts/setup.js --password-only",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning scripts/test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.6.0",
    "qrcode": "^1.5.4"
  }
}
