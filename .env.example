# Run `npm run setup` to generate a real .env — do not copy this file by hand.

# Secrets (generated by setup). NEVER share these. Losing MASTER_KEY makes stored files unreadable.
MASTER_KEY=
SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASS_HASH=

# Server
PORT=3000
# Public HTTPS address customers use (e.g. your Cloudflare Tunnel URL). Used for the shop QR poster.
PUBLIC_URL=

# Printing: "auto" uses the real Windows printer, "simulate" only pretends (for testing)
PRINT_MODE=auto

# Privacy: delete uploaded files this many hours after an order is finished
FILE_RETENTION_HOURS=72
# Erase customer name/phone from finished orders after this many days
PII_RETENTION_DAYS=90

# Optional: instant phone alerts via a Telegram bot (create one with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
